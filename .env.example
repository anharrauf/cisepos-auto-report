# Copy to .env; supply credentials locally. Never commit .env.
CISEPOS_USERNAME=
CISEPOS_PASSWORD=
CISEPOS_HEADLESS=true
CISEPOS_TIMEOUT_MS=30000
# Optional overrides; verify against the live page.
# CISEPOS_USERNAME_SELECTOR=input[name="username"]
# CISEPOS_PASSWORD_SELECTOR=input[type="password"]
# CISEPOS_SUBMIT_SELECTOR=button[type="submit"]
# REQUIRED: set a selector you confirmed exists ONLY on the authenticated dashboard.
CISEPOS_SUCCESS_SELECTOR=
# CISEPOS_ERROR_SELECTOR=.alert-danger:visible
# Optional system Chromium instead of Playwright-managed Chromium:
# CISEPOS_CHROMIUM_PATH=/usr/bin/chromium

# Purchase report: CSS selectors MUST be confirmed once on the live report page.
CISEPOS_PURCHASE_REPORT_URL=https://mkenter.express-cisepos.com/public/reports/AllBranchesPurchaseReport
CISEPOS_REPORT_TYPE=WithTax&Disc
CISEPOS_REPORT_TIMEOUT_MS=120000
CISEPOS_REPORT_START_SELECTOR=
CISEPOS_REPORT_END_SELECTOR=
CISEPOS_REPORT_TYPE_SELECTOR=
CISEPOS_REPORT_GENERATE_SELECTOR=
CISEPOS_REPORT_TABLE_SELECTOR=
CISEPOS_REPORT_LENGTH_SELECTOR=
CISEPOS_REPORT_EXCEL_SELECTOR=

REPORT_DATE_MODE=yesterday
REPORT_TIMEZONE=Asia/Karachi
DOWNLOAD_BASE_DIR=data
# Canonical field -> exact Excel heading, JSON (single quote the JSON in .env).
PURCHASE_COLUMN_MAP={}
# Optional zero-based row index; empty means auto-detect within first 40 rows.
PURCHASE_HEADER_ROW=
# Zero-based sheet index or exact sheet name.
PURCHASE_SHEET=0
PURCHASE_BRANCH_AWARE=false
# Required ONLY if the workbook has no unit column. Never mix units.
PURCHASE_DEFAULT_UNIT=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=60
EMAIL_FROM=
# Comma-separated recipients.
EMAIL_TO=
EMAIL_SUBJECT_PREFIX=CISEPOS Purchases
EMAIL_MAX_ATTACHMENT_MB=20
